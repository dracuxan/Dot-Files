#!/bin/bash
FILE_PATH=$1
shift     # Remove the file path from the list of arguments
ARGS="$@" # Capture any additional arguments

BUILD_ONLY=false
TEST_PROJECT=false
REPL=false
MIX=false
C_FLAGS=""

for arg in "$@"; do
    case $arg in
    --build | -b)
        BUILD_ONLY=true
        shift
        ;;
    --test | -t)
        TEST_PROJECT=true
        shift
        ;;
    --repl | -r)
        REPL=true
        shift
        ;;
    --mix | -m)
        MIX=true
        shift
        ;;
    --cflags)
        shift
        C_FLAGS="$1"
        shift
        ;;
    esac
done

# Ensure a file path is provided
if [[ -z "$FILE_PATH" ]]; then
    echo "Usage: $0 <source_file> [program arguments if any] [--build-only(optional)]"
    exit 1
fi

EXT="${FILE_PATH##*.}"
FILE_NAME=$(basename "$FILE_PATH" ."$EXT")

case "$EXT" in
c)
    echo "Compiling ${FILE_NAME}.c..."
    # Ensure 'bin' directory exists for compiled binaries
    mkdir -p "bin"
    gcc -Wall -Wextra -lm $C_FLAGS "$FILE_PATH" -o "bin/${FILE_NAME}"
    if [[ $? -ne 0 ]]; then
        echo "Compilation failed."
        exit 1
    fi
    if $BUILD_ONLY; then
        echo "done"
        exit 0
    fi
    echo ""
    echo "Running bin/${FILE_NAME}..."
    echo ""
    ./bin/${FILE_NAME} $ARGS
    ;;
go)
    if $TEST_PROJECT; then
        echo "Running tests..."
        echo ""
        GO_TEST_DIR=$(dirname "$FILE_PATH")
        GO_MODULE_ROOT="$GO_TEST_DIR"

        if [[ -f "$GO_MODULE_ROOT/go.mod" ]]; then
            (
                cd "$GO_MODULE_ROOT" || exit 1
                go test ./...
            )
        else
            (
                cd "$GO_TEST_DIR" || exit 1
                go test .
            )
        fi
        exit $?
    else
        echo "Compiling ${FILE_NAME}.go..."
        echo ""
        # Ensure 'bin' directory exists for compiled binaries
        mkdir -p "bin"
        go build -o "bin/${FILE_NAME}" "$FILE_PATH"
        if [[ $? -ne 0 ]]; then
            echo "Compilation failed."
            exit 1
        fi
        if $BUILD_ONLY; then
            echo "Binary compiled at bin/${FILE_NAME}"
        else
            echo "Running bin/${FILE_NAME}..."
            ./bin/${FILE_NAME} $ARGS
        fi
    fi
    ;;
rs)
    if $TEST_PROJECT; then
        cargo test
    elif $BUILD_ONLY; then
        cargo build
    else
        cargo run
    fi
    ;;
exs | ex)
    if $TEST_PROJECT; then
        mix test
    elif $MIX; then
        echo "running script with mix..."
        echo ""
        mix run ${FILE_PATH}
    elif $REPL; then
        if [[ "$EXT" == "exs" ]] && [[ "$FILE_NAME" != "mix" ]]; then
            echo "starting iex repl..."
            echo ""
            iex ${FILE_PATH}
        else
            echo "running app with iex..."
            echo ""
            iex -S mix
        fi
    else
        if [[ "$EXT" == "exs" ]] && [[ "$FILE_NAME" != "mix" ]]; then
            echo "Running ${FILE_NAME}.exs with elixir..."
            echo ""
            elixir "$FILE_PATH" $ARGS
        else
            if $BUILD_ONLY; then
                echo "Compiling mix project..."
                echo ""
                mix escript.build

            else
                echo "Running mix project..."
                echo ""
                mix run
            fi
        fi

    fi
    ;;
ml)
    ML_DIR=$(dirname "$FILE_PATH")
    ML_ROOT="$ML_DIR"
    ML_HAS_DUNE=false

    while [[ "$ML_ROOT" != "/" ]]; do
        if [[ -f "$ML_ROOT/dune-project" ]] || [[ -f "$ML_ROOT/dune-workspace" ]]; then
            ML_HAS_DUNE=true
            break
        fi
        ML_ROOT=$(dirname "$ML_ROOT")
    done

    if ! $ML_HAS_DUNE && [[ -f "$ML_DIR/dune" ]]; then
        ML_ROOT="$ML_DIR"
        ML_HAS_DUNE=true
    fi

    if $TEST_PROJECT; then
        echo "Running OCaml tests..."
        echo ""
        if $ML_HAS_DUNE; then
            (
                cd "$ML_ROOT" || exit 1
                dune runtest
            )
        else
            ocaml "$FILE_PATH"
        fi
        exit $?

    elif $REPL; then
        echo "Starting OCaml REPL..."
        echo ""
        if command -v utop >/dev/null 2>&1; then
            utop -require base
        else
            ocaml
        fi

    elif $BUILD_ONLY; then
        echo "Building ${FILE_NAME}.ml..."
        echo ""
        if $ML_HAS_DUNE; then
            ML_REL_PATH=$(realpath --relative-to="$ML_ROOT" "$FILE_PATH")
            ML_EXE_TARGET="./${ML_REL_PATH%.$EXT}.exe"
            (
                cd "$ML_ROOT" || exit 1
                dune build "$ML_EXE_TARGET"
            )
        else
            mkdir -p target
            ocamlc "$FILE_PATH" -o "target/${FILE_NAME}"
        fi
        exit $?

    else
        echo "Running ${FILE_NAME}.ml..."
        echo ""
        if $ML_HAS_DUNE; then
            ML_REL_PATH=$(realpath --relative-to="$ML_ROOT" "$FILE_PATH")
            ML_EXE_TARGET="./${ML_REL_PATH%.$EXT}.exe"
            (
                cd "$ML_ROOT" || exit 1
                dune exec "$ML_EXE_TARGET" -- $ARGS
            )
        else
            ocaml "$FILE_PATH" $ARGS
        fi
        exit $?
    fi
    ;;
sh)
    echo "Running ${FILE_NAME}.sh script...."
    echo ""
    bash $FILE_PATH
    ;;
html)
    echo "starting http server..."
    echo ""
    http-server --port 5173
    ;;
*)
    echo "Unsupported file type: .$EXT"
    exit 1
    ;;
esac

exit 0
