{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "padding": {
      "top": 2,
      "left": 3,
    },
  },
  "display": {
    "separator": "",
    "key": {
      "width": 15,
    },
    "color": {
      "keys": "white",
      "title": "white",
    },
  },
  "modules": [
    {
      "key": "╭───────────╮",
      "type": "custom",
    },
    {
      "key": "│           │\u001b[11D{#37} user",
      "type": "title",
    },
    {
      "key": "│           │\u001b[11D{#90}󰣇 os",
      "type": "os",
      "format": "{2}",
    },
    {
      "key": "│           │\u001b[11D{#90}󰅐 uptime",
      "type": "uptime",
    },
    {
      "key": "│           │\u001b[11D{#37} term",
      "type": "terminal",
      "format": "{5}",
    },
    {
      "key": "│           │\u001b[11D{#90} shell",
      "type": "shell",
    },
    {
      "key": "│           │\u001b[11D{#37}󰍛 cpu",
      "type": "cpu",
      "format": "{1}",
    },
    {
      "key": "│           │\u001b[11D{#37}󰍛 gpu",
      "type": "gpu",
      "format": "{2}",
    },
    {
      "key": "│           │\u001b[11D{#90} memory",
      "type": "memory",
    },
    {
      "key": "│           │\u001b[11D{#37}󰓡 swap",
      "type": "swap",
    },
    {
      "key": "│           │\u001b[11D{#90}󰩟 network",
      "type": "localip",
      "format": "{1} ({4})",
    },
    {
      "key": "╰───────────╯",
      "type": "custom",
    },
  ],
}
