[global]
# Appearance
font = "JetBrainsMono Nerd Font 10"
transparency = 1
frame_color = "#525252"
separator_color = "#525252"
monitor = 1

# Colors matching your i3 config
background = "#060606"
foreground = "#e1e1e1"
timeout = 5

[urgency_low]
background = "#060606"
foreground = "#7c7c7c"
timeout = 3

[urgency_normal]
background = "#282828"
foreground = "#e1e1e1"
timeout = 5

[urgency_critical]
background = "#525252"
foreground = "#e1e1e1"
frame_color = "#e1e1e1"
timeout = 0

[volume]
summary = "Volume"
skip_display = true
